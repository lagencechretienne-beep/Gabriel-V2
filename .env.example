# ── Core ──────────────────────────────────────────────────────────────────────
# Clé de signature des sessions : 24 caractères minimum, aléatoire, jamais celle de l'exemple.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=VOTRE_CLE_SECRETE_ALEATOIRE_ICI
# OBLIGATOIRE sur un serveur déployé. Sans lui (valeur 'false' par défaut dans le code), chaque
# visiteur devient le même utilisateur de développement : tout est partagé, sans connexion.
# Un serveur déclaré déployé (RENDER ou GABRIEL_ENV=production) refuse de démarrer sans lui.
AUTH_ENABLED=true
# Coupe-circuit du niveau 1 : false garde le site public en ligne mais ferme
# connexion, inscription et API privées. Sur Render, la valeur par défaut est
# false. Ne passer à true qu'avec Supabase configuré et validé.
GABRIEL_ACCOUNTS_ENABLED=false
GABRIEL_PROSPECT_ENABLED=false
MEMORY_SHARE_ACROSS_USERS=false
# À définir sur le serveur déployé (Render le fait déjà via RENDER=true).
# GABRIEL_ENV=production
APP_URL=https://votre-domaine.com
# UUID internes autorises a administrer Gabriel (separes par des virgules).
# Valeur absente ou malformee = aucun administrateur. Les emails sont ignores.
# ADMIN_USER_IDS=00000000-0000-4000-8000-000000000000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# RATE_LIMIT_ENABLED=false  désactive tout le rate limiting (utile en dev local)
RATE_LIMIT_ENABLED=true
# Surcharger les limites individuelles (syntaxe flask-limiter : "N per période")
# RATE_LIMIT_ANALYZE=10 per hour
# RATE_LIMIT_STRATEGIZE=20 per hour
# RATE_LIMIT_CREATOR=30 per hour
# RATE_LIMIT_CHAT=60 per hour
# RATE_LIMIT_EXPORT_PDF=10 per hour

# ── Mistral ───────────────────────────────────────────────────────────────────
MISTRAL_API_KEY=VOTRE_CLE_MISTRAL_ICI

# ── OpenAI (Orchestrateur uniquement) ────────────────────────────────────────
OPENAI_API_KEY=VOTRE_CLE_OPENAI_ICI
OPENAI_ORCHESTRATOR_MODEL=gpt-5.6-sol

# ── Anthropic (optionnel — réservé usage futur) ───────────────────────────────
ANTHROPIC_API_KEY=

# ── YouTube ───────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=VOTRE_CLE_YOUTUBE_ICI

# ── RapidAPI (Instagram, TikTok) ──────────────────────────────────────────────
RAPIDAPI_KEY=VOTRE_CLE_RAPIDAPI_ICI

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://VOTRE_PROJET.supabase.co
SUPABASE_KEY=VOTRE_CLE_SERVEUR_SUPABASE
# Clé service role (migrations, webhooks) — ne jamais exposer côté client
SUPABASE_SERVICE_ROLE_KEY=

# ── Google OAuth (optionnel) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_EARLY_ACCESS_PRICE_ID=
STRIPE_STANDARD_PRICE_ID=
STRIPE_PME_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ─── Choix du fournisseur de modèle ──────────────────────────────────────────
# Les agents (Psychologue, Stratège, Créateur) passent tous par core/llm_client.
# Basculer de fournisseur ne demande aucune modification de code.
#   mistral (défaut) | openai
LLM_PROVIDER=mistral

# Modèles Mistral par palier. Défauts : mistral-small-latest (rapide) et mistral-large-latest (profond).
# Un plan Mistral limité n'autorise parfois que les modèles « ministral » : dans ce cas, les fixer ici.
# MISTRAL_MODEL_FAST=ministral-14b-latest
# MISTRAL_MODEL_DEEP=ministral-14b-latest

# Ledger transactionnel de credits (phase 1). Desactive par defaut : tant que
# la migration et le branchement des routes ne sont pas valides, l'application
# conserve strictement le mecanisme historique.
GABRIEL_CREDIT_LEDGER_ENABLED=false

# Coupe-circuit des appels payants. Sur Render/GABRIEL_ENV=production, la
# valeur par defaut est false et bloque tout appel avant le reseau. Ne passer a
# true qu'apres migration, configuration et validation des limites ci-dessous.
GABRIEL_PAID_AI_ENABLED=false
# Quand le garde est actif, chaque POST payant doit fournir une cle HTTP
# Idempotency-Key stable pour qu'une reprise reseau ne relance pas le fournisseur.

# Garde financier applicatif — inactif tant que le schema, les barèmes et les
# politiques PostgreSQL n'ont pas été validés en préproduction. Quand il vaut
# true, le ledger doit aussi être activé et TOUTE valeur ci-dessous devient
# obligatoire. Une configuration absente/incomplète bloque l'appel avant le
# fournisseur.
GABRIEL_PROVIDER_COST_GUARD_ENABLED=false
# Marge sur l'estimation haute des tokens d'entrée (>= 1).
# GABRIEL_PROVIDER_INPUT_TOKEN_MARGIN=1.25
# Les plafonds utilisateur/global et leur période ne viennent jamais de
# l'application. Ils sont provisionnés explicitement dans PostgreSQL par une
# opération administrative inaccessible aux rôles d'exécution. Une politique
# absente, désactivée, expirée ou incohérente bloque tout appel fournisseur.
# Tarifs vérifiés et versionnés. Pour STT/TTS sans mesure de coût exploitable,
# utiliser max_attempt_usd : ce plafond entier est alors comptabilisé.
# GABRIEL_PROVIDER_PRICING_JSON={"mistral":{"MODELE_VERSIONNE":{"input_usd_per_million":"A_DEFINIR","output_usd_per_million":"A_DEFINIR"}},"openai":{"MODELE_VERSIONNE":{"input_usd_per_million":"A_DEFINIR","output_usd_per_million":"A_DEFINIR"}},"elevenlabs":{"scribe_v1":{"max_attempt_usd":"A_DEFINIR"},"eleven_multilingual_v2":{"max_attempt_usd":"A_DEFINIR"}},"youtube":{"youtube_data_api":{"max_attempt_usd":"A_DEFINIR"}},"rapidapi":{"instagram_comments":{"max_attempt_usd":"A_DEFINIR"},"tiktok_detail":{"max_attempt_usd":"A_DEFINIR"},"tiktok_comments":{"max_attempt_usd":"A_DEFINIR"}}}
# Barème commercial par opération. Toutes les opérations listées par l'app
# doivent être présentes avant activation ; sinon elles sont refusées.
# Opérations : psychologue, psychologue_preview, psychologue_cross, stratege, createur,
# createur_refine, context_chat, voice_stt, voice_tts, strategy_session,
# strategy_chat, orchestrator.
# GABRIEL_AI_OPERATION_BUDGETS_JSON={"psychologue":{"credits":"A_DEFINIR","provider_budget_usd":"A_DEFINIR","pricing_version":"A_VALIDER"}}
# Plafond d'appels simultanés et délai minimal (secondes) entre deux lancements, partagés par tous
# les utilisateurs : c'est le vrai plafond de capacité. À relever si votre plan Mistral le permet.
# MISTRAL_MAX_CONCURRENCY=2
# MISTRAL_MIN_INTERVAL=1.0
# Modèle de l'Orchestrateur (par défaut : le palier profond).
# MISTRAL_ORCHESTRATOR_MODEL=

# Validation IA reelle controlee -- DESACTIVEE par defaut.
# En mode actif, les trois modeles ci-dessus doivent etre des identifiants
# versionnes (jamais *-latest) et chacun doit avoir un tarif explicite ci-dessous.
MISTRAL_VALIDATION_BUDGET_ENABLED=false
# Identifiant unique de campagne. Le reutiliser reprend exactement le meme ledger.
# MISTRAL_VALIDATION_RUN_ID=coeur-ab-YYYYMMDD
# MISTRAL_VALIDATION_BUDGET_USD=2.00
# Plafond GLOBAL de tentatives physiques, retries compris.
# MISTRAL_VALIDATION_MAX_ATTEMPTS=100
# Chemin ABSOLU sur un disque persistant, hors repertoire ephemere du deploiement.
# MISTRAL_VALIDATION_LEDGER_PATH=/chemin/persistant/mistral-validation.sqlite3
# Marge conservatrice appliquee a l'estimation haute des tokens d'entree (>= 1).
# MISTRAL_VALIDATION_INPUT_MARGIN=1.25
# Tarifs verifies au moment du test, en USD par million de tokens. Exemple de forme :
# MISTRAL_VALIDATION_PRICING_JSON={"modele-versionne":{"input_usd_per_million":"0.00","output_usd_per_million":"0.00"}}

# Catalogue OpenAI, utilisé uniquement si LLM_PROVIDER=openai.
# Le palier « rapide » sert aux tâches déterministes (extraction,
# classification), le palier « profond » à l'analyse et à l'arbitrage.
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_DEEP=gpt-4o

# ─── Réglages de fonctionnement (tous facultatifs) ────────────────────────────
# Isolation : la mémoire stratégique (offres, prix, décisions) est cloisonnée par compte.
# Mettre 'true' pour que tous les comptes s'inspirent des cas des autres (équipe unique seulement).
# MEMORY_SHARE_ACROSS_USERS=false
# Au démarrage, marque « interrompus » les travaux restés en cours sans signe de vie (mettre 0 pour couper).
# JOB_SWEEP_ON_START=1
# Force IPv4 pour les appels sortants (un IPv6 cassé bloquait YouTube, Mistral et Supabase).
# PREFER_IPV4=true
# Précharge le modèle sémantique au démarrage (démarrage plus lent, première analyse plus rapide).
# NLP_PRELOAD=true
# RAG_PRELOAD=false
# Moteur de création par pipeline (0 = ancien Créateur) et longueur maximale d'une création.
# CREATOR_PIPELINE=1
# CREATOR_MAX_TOKENS=12000
# Durée pendant laquelle une Cross Analyse identique est réutilisée sans être facturée à nouveau.
# CROSS_ANALYSIS_CACHE_TTL_SECONDS=3600
# Limites de débit supplémentaires (syntaxe « N per hour »).
# RATE_LIMIT_LOGIN=10 per hour
# RATE_LIMIT_UPLOAD=20 per hour
# RATE_LIMIT_VOICE=60 per hour

# ─── Voix (Entretien stratégique) ─────────────────────────────────────────────
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_TTS_MODEL_ID=
